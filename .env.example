# Reddit saved items are read from old.reddit.com/user/<you>/saved.json using your
# logged-in session cookie — no Reddit OAuth app needed.

# Your Reddit username (non-secret).
REDDIT_USERNAME=

# Your reddit_session cookie, copied from a logged-in browser's DevTools
# (Application -> Cookies -> reddit.com), as "reddit_session=<value>". Lasts ~a
# year; when it expires requests 403 and the auth-failure hook fires.
REDDIT_COOKIE=reddit_session=

# Pinboard API token, format "username:TOKEN" (https://pinboard.in/settings/password)
PINBOARD_TOKEN=

# Every secret above also accepts a <VAR>_FILE sibling pointing at a file containing the
# value (read and trimmed). Handy for sops-nix / systemd. Example:
# REDDIT_COOKIE_FILE=/run/secrets/reddit-cookie
# PINBOARD_TOKEN_FILE=/run/secrets/pinboard-token

# Optional: shell command run when the Reddit cookie needs refreshing.
# PINBOARD_SYNC_ON_AUTH_FAILURE=curl -m 10 -d "$PINBOARD_SYNC_AUTH_ERROR" https://example.com/hook
