# Credentials for pinboard-sync. The Pinboard token is the shared destination; each
# source you use adds its own auth. Set only the ones you need.

# Pinboard API token, format "username:TOKEN" (https://pinboard.in/settings/password)
PINBOARD_TOKEN=

# --- Reddit (saved posts/comments) ---
# Saved items are read from old.reddit.com/user/<you>/saved.json using your logged-in
# session cookie — no Reddit OAuth app needed.
# Your Reddit username (non-secret).
REDDIT_USERNAME=
# Your reddit_session cookie, copied from a logged-in browser's DevTools
# (Application -> Cookies -> reddit.com), as "reddit_session=<value>". Lasts ~a year;
# when it expires requests 403 and, if configured, the auth-failure hook fires.
REDDIT_COOKIE=reddit_session=

# --- GitHub (starred repos) ---
# A personal access token (public_repo / read scope is enough; only reads /user/starred).
GITHUB_TOKEN=

# --- HackerNews (favorited stories/comments) ---
# Your HackerNews username (favorites are public; no token needed).
HN_USERNAME=

# Every variable above also accepts a <VAR>_FILE sibling pointing at a file containing
# the value (read and trimmed). Handy for sops-nix / systemd. Example:
# REDDIT_COOKIE_FILE=/run/secrets/reddit-cookie
# GITHUB_TOKEN_FILE=/run/secrets/github-token
# PINBOARD_TOKEN_FILE=/run/secrets/pinboard-token

# Optional: shell command run when a source needs re-authentication (e.g. an expired
# Reddit cookie). PINBOARD_SYNC_AUTH_ERROR / PINBOARD_SYNC_EVENT are set in its env.
# PINBOARD_SYNC_ON_AUTH_FAILURE=curl -m 10 -d "$PINBOARD_SYNC_AUTH_ERROR" https://example.com/hook
